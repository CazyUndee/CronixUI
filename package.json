{
  "name": "cronixui",
  "version": "1.1.5",
  "description": "CronixUI - Cross-framework dark-themed UI toolkit with crimson accents. Supports React, Vue, Svelte, Solid, TypeScript, Python, Go, Rust, Flutter.",
  "keywords": [
    "ui",
    "css",
    "dark-mode",
    "design-system",
    "components",
    "typescript",
    "python",
    "rust",
    "golang"
  ],
  "license": "GPL-3.0",
  "author": "CazyUndee",
  "type": "commonjs",
  "main": "packages/web/dist/cronixui.js",
  "style": "packages/web/dist/cronixui.css",
  "types": "packages/web/src/cronixui.d.ts",
  "exports": {
    ".": {
      "import": "./packages/web/dist/cronixui.js",
      "require": "./packages/web/dist/cronixui.js",
      "style": "./packages/web/dist/cronixui.css",
      "types": "./packages/web/src/cronixui.d.ts"
    },
    "./react": {
      "import": "./packages/react/dist/index.js",
      "require": "./packages/react/dist/index.js",
      "types": "./packages/react/dist/index.d.ts"
    },
    "./typescript": {
      "import": "./packages/typescript/dist/index.js",
      "types": "./packages/typescript/dist/index.d.ts"
    },
    "./tokens": {
      "import": "./packages/typescript/dist/tokens.js",
      "types": "./packages/typescript/dist/tokens.d.ts"
    },
    "./css": "./packages/web/dist/cronixui.css",
    "./css/min": "./packages/web/dist/cronixui.min.css",
    "./js": "./packages/web/dist/cronixui.js",
    "./js/min": "./packages/web/dist/cronixui.min.js"
  },
  "files": [
    "packages/web/dist/",
    "packages/react/src/",
    "packages/react/dist/",
    "packages/typescript/dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "node packages/web/scripts/build.js",
    "build:ts": "cd packages/typescript && npm run build",
    "dev": "npx live-server packages/web/demo",
    "gen": "tsx packages/spec/generate.ts",
    "gen:all": "tsx packages/spec/generate.ts --all",
    "website:dev": "cd website && npm run dev",
    "website:build": "cd website && npm run build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "publish:dry": "pnpm -r publish --dry-run --access public"
  },
  "workspaces": [
    "packages/react",
    "packages/svelte",
    "packages/solid",
    "packages/vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CazyUndee/CronixUI.git"
  }
}
